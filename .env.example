# .env.example - copie para .env e preencha com valores reais
# Não comite o arquivo .env com segredos no repositório

# PostgreSQL (ou use DATABASE_URL)
PGHOST=localhost
PGUSER=seu_usuario
PGPASSWORD=sua_senha
PGDATABASE=seu_banco
PGPORT=5432
PGSSL=false

# App
PORT=3000

# Secret para JWT quando implementar autenticação
JWT_SECRET=troque_este_valor